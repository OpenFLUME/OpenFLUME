{
  // Node tooling: the companion server, generators, and the build/test
  // configs. No DOM lib — these never run in a browser.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "scripts/**/*",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.fast.config.ts",
    "eslint.config.js",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "scripts/__tests__/**",
    "scripts/capture-manual-figures.ts",
    "node_modules",
    "dist"
  ]
}
