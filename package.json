{
  "name": "openflume",
  "private": true,
  "version": "0.1.0",
  "description": "OpenFLUME (Open FLUid Model Environment): open-source thermal-fluid network solver with steady/transient analysis, parameter sweeps, and a visual P&ID editor",
  "keywords": [
    "thermal-fluid",
    "network-solver",
    "heat-transfer",
    "fluid-flow",
    "two-phase",
    "coolprop",
    "engineering",
    "research",
    "open-source",
    "P&ID"
  ],
  "license": "MIT",
  "author": "OpenFLUME contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenFLUME/OpenFLUME.git"
  },
  "bugs": {
    "url": "https://github.com/OpenFLUME/OpenFLUME/issues"
  },
  "homepage": "https://github.com/OpenFLUME/OpenFLUME#readme",
  "type": "module",
  "packageManager": "npm@10.8.3",
  "engines": {
    "node": ">=22.9.0 <23",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.fast.config.ts",
    "test:all": "vitest run --config vitest.config.ts",
    "test:slow": "RUN_SLOW=1 vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:smoke": "playwright test e2e/connection-orientation.spec.ts",
    "gen:trace-corpus": "tsx scripts/build-nbs-trace-corpus.ts",
    "gen:fluid-catalogue": "tsx scripts/build-fluid-catalogue.ts",
    "check:fluid-catalogue": "tsx scripts/build-fluid-catalogue.ts --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run build && npm test",
    "preview": "vite preview",
    "serve": "npm run build && tsx scripts/serve.ts",
    "serve:dist": "tsx scripts/serve.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xyflow/react": "^12.11.3",
    "coolprop-wasm": "^6.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^2.1.5"
  }
}
